# Copy to .env (the installer does this for you) and fill in.
# teams_notify.py and verify.sh auto-load this file via python-dotenv — no shell setup.
# Tip: if you hand-edit, wrap values in single quotes (configure.sh does this for you).
# Workflows webhook URLs contain '&', which is safe inside quotes: KEY='https://...&...'

# --- Channel posts (Power Automate Workflows webhook) ---
TEAMS_WEBHOOK_URL=

# --- Direct messages + group/meeting chats (Microsoft Graph, delegated device-code) ---
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
